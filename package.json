{
  "name": "prosody-obsidian",
  "version": "0.3.0",
  "private": true,
  "description": "Local transcription, word-synced playback, and AI summaries through any ACP agent.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --prod",
    "typecheck": "tsc --noEmit",
    "lint:oxlint": "oxlint --type-aware --type-check --threads=1",
    "lint:fix": "oxlint --fix",
    "lint": "bun run lint:oxlint && bun run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run build",
    "deploy": "node esbuild.config.mjs && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@types/node": "26.5.1",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "esbuild"
  ]
}
